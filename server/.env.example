# ============================================================================
# DIVINE FAVOUR BACKEND — ENVIRONMENT TEMPLATE
# ============================================================================
# Safe template for production and development deployments.
# NEVER commit .env files containing real passwords or secrets to version control.
# ============================================================================

# ----------------------------------------------------------------------------
# 1. RUNTIME & SERVER CONFIGURATION
# ----------------------------------------------------------------------------
# HTTP port for the Express application.
# On cloud platforms (Render, Railway, Fly.io, Heroku), PORT is typically assigned automatically.
PORT=5000

# Runtime environment (production | development | test)
# Set to 'production' on live deployments to enforce strict security checks.
NODE_ENV=production

# ----------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL)
# ----------------------------------------------------------------------------
# Managed PostgreSQL connection string (Prisma & pg pool format).
# Append ?sslmode=require for managed database providers (Neon, Supabase, Render, AWS RDS).
DATABASE_URL="postgresql://db_user:db_password@db_host:5432/divine_favour_prod?sslmode=require&schema=public"

# Optional explicit SSL override (set to true if provider requires SSL connections)
# DATABASE_SSL=true

# ----------------------------------------------------------------------------
# 3. CORS & FRONTEND ORIGIN CONFIGURATION
# ----------------------------------------------------------------------------
# Comma-separated list of fully-qualified frontend origins allowed to make API requests with credentials.
# Wildcards (*) are rejected in production when credentials (cookies) are transmitted.
# Example: "https://divinefavourpackaging.com,https://www.divinefavourpackaging.com"
CORS_ORIGIN="https://divinefavourpackaging.com,https://www.divinefavourpackaging.com"

# ----------------------------------------------------------------------------
# 4. SESSION & COOKIE SECURITY (Argon2id + connect-pg-simple)
# ----------------------------------------------------------------------------
# Cryptographically random secret key (minimum 32 characters required in production).
# Generate securely via: openssl rand -hex 32  OR  node -e "console.log(crypto.randomBytes(32).toString('hex'))"
SESSION_SECRET="generate-a-secure-random-64-character-hex-string-for-production"

# Session expiration lifetime in milliseconds (default: 86400000 = 24 hours)
SESSION_MAX_AGE_MS=86400000

# Enforce secure cookies (must be 'true' in production with HTTPS)
COOKIE_SECURE=true

# Cookie SameSite policy ('lax' for same-site or subdomain setups; 'none' if cross-domain)
COOKIE_SAME_SITE=lax

# ----------------------------------------------------------------------------
# 5. RATE LIMITING & ABUSE PREVENTION
# ----------------------------------------------------------------------------
# Rate limiting window for authentication endpoints (in milliseconds; default 15 minutes = 900000)
AUTH_RATE_LIMIT_WINDOW_MS=900000

# Maximum login attempts per IP per 15-minute window (default: 10)
AUTH_RATE_LIMIT_MAX=10

# ----------------------------------------------------------------------------
# 6. ONE-TIME INITIAL ADMINISTRATOR PROVISIONING (Optional CLI environment variables)
# ----------------------------------------------------------------------------
# Used exclusively by `npm run admin:provision`.
# Do NOT leave these values populated in standing production environment variables.
# ADMIN_NAME="Divine Favour Administrator"
# ADMIN_EMAIL="admin@divinefavourpackaging.com"
# ADMIN_PASSWORD="ReplaceWithAStrongPassphrase123!"
# ADMIN_ROLE="ADMIN"
