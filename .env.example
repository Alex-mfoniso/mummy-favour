# ============================================================================
# DIVINE FAVOUR FRONTEND — ENVIRONMENT TEMPLATE
# ============================================================================
# Safe template for production and development builds.
#
# IMPORTANT SECURITY NOTICE:
# In Vite / React single-page applications, all variables prefixed with `VITE_`
# are statically embedded into client-side JavaScript bundles during `npm run build`.
# They are PUBLICLY VISIBLE to all website visitors.
#
# NEVER put database URLs, session secrets, private keys, or administrator
# credentials in this file.
# ============================================================================

# ----------------------------------------------------------------------------
# 1. API CONNECTION
# ----------------------------------------------------------------------------
# Backend REST API Base URL.
# In production, set this to your deployed API domain:
# Example: https://api.divinefavourpackaging.com/api/v1
# Or relative path if reverse-proxied behind the same domain: /api/v1
VITE_API_BASE_URL=https://api.divinefavourpackaging.com/api/v1

# ----------------------------------------------------------------------------
# 2. OPTIONAL STATIC CONTACT OVERRIDES (Fallback defaults)
# ----------------------------------------------------------------------------
# Note: The application automatically pulls live business contact information
# from the backend Business Settings API (/api/v1/business-settings).
# These environment variables serve as initial compile-time fallbacks.
# Leave blank to rely entirely on dynamic settings managed via the Admin Dashboard.

# Official Business WhatsApp Number for Direct Customer Quotations
# Format: International country code + digits without '+' or spaces (e.g. 2348012345678).
# If empty, the UI displays an informative notice while preserving the submitted enquiry.
VITE_BUSINESS_WHATSAPP_NUMBER=

# Official Business Phone Line
# Format: e.g. "+234 801 234 5678". Leave blank until verified.
VITE_BUSINESS_PHONE=

# Official Business Email Address
# Format: e.g. "sales@divinefavourpackaging.com". Leave blank until verified.
VITE_BUSINESS_EMAIL=

# Official Factory / Plant Physical Address
# Format: e.g. "Industrial Layout, Ikeja, Lagos, Nigeria". Leave blank until verified.
VITE_BUSINESS_ADDRESS=

# Official Google Maps or Map Location URL
# Leave blank until physical coordinates are confirmed.
VITE_BUSINESS_MAP_URL=

# Confirmed Business Operational Hours
# Format: e.g. "Monday – Friday: 8:00 AM – 5:00 PM (WAT)". Leave blank until confirmed.
VITE_BUSINESS_HOURS=
